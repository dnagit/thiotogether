// CMS Platform — normalized PostgreSQL schema.
// Conventions: every table has id / created_at / updated_at / deleted_at (soft delete).
// JSON columns hold open-shaped data (block props, form field options, OCR raw results).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Auth & RBAC ───────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(190)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(120)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id])

  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  media              Media[]
  auditLogs          AuditLog[]
  verifiedDonations  Donation[]         @relation("DonationVerifier")
  donationLogs       DonationLog[]
  tokenLedgerEntries TokenLedgerEntry[]
  revealEvents       RevealEvent[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(60)
  displayName String  @map("display_name") @db.VarChar(120)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  roles RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("password_resets")
}

// ─────────────────────────── Content ───────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(255)
  slug     String @db.VarChar(255)
  // Materialized full URL path, unique among live pages; recomputed for the
  // whole subtree whenever slug or parent changes.
  path     String @db.VarChar(1000)
  parentId Int?   @map("parent_id")
  parent   Page?  @relation("PageTree", fields: [parentId], references: [id])
  children Page[] @relation("PageTree")

  featuredImage String? @map("featured_image") @db.VarChar(500)
  bannerImage   String? @map("banner_image") @db.VarChar(500)

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  sortOrder   Int           @default(0) @map("sort_order")
  isHome      Boolean       @default(false) @map("is_home")

  // SEO
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.VarChar(500)
  canonicalUrl    String? @map("canonical_url") @db.VarChar(500)
  ogTitle         String? @map("og_title") @db.VarChar(255)
  ogDescription   String? @map("og_description") @db.VarChar(500)
  ogImage         String? @map("og_image") @db.VarChar(500)
  twitterCard     String? @map("twitter_card") @db.VarChar(40)
  jsonLd          Json?   @map("json_ld")
  noIndex         Boolean @default(false) @map("no_index")

  blocks    PageBlock[]
  menuItems MenuItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([parentId])
  @@index([status])
  @@index([path])
  @@map("pages")
}

model PageBlock {
  id     Int  @id @default(autoincrement())
  pageId Int  @map("page_id")
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type      String @db.VarChar(80)
  props     Json
  styles    Json
  settings  Json
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([pageId, sortOrder])
  @@map("page_blocks")
}

model Menu {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(120)
  location String  @unique @db.VarChar(80)
  isActive Boolean @default(true) @map("is_active")

  items MenuItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("menus")
}

enum MenuItemType {
  PAGE
  EXTERNAL
  CATEGORY
  ANCHOR
  CUSTOM
}

model MenuItem {
  id       Int        @id @default(autoincrement())
  menuId   Int        @map("menu_id")
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId Int?       @map("parent_id")
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemTree")

  label  String       @db.VarChar(120)
  icon   String?      @db.VarChar(80)
  type   MenuItemType @default(PAGE)
  pageId Int?         @map("page_id")
  page   Page?        @relation(fields: [pageId], references: [id])
  url    String?      @db.VarChar(500)
  target String       @default("_self") @db.VarChar(10)

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([menuId])
  @@index([parentId])
  @@map("menu_items")
}

// ─────────────────────────── Forms ───────────────────────────

model Form {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(150)
  slug           String  @unique @db.VarChar(150)
  description    String? @db.VarChar(500)
  submitLabel    String  @default("Submit") @map("submit_label") @db.VarChar(60)
  successMessage String  @default("Thank you!") @map("success_message") @db.VarChar(500)
  notifyEmail    String? @map("notify_email") @db.VarChar(190)
  isActive       Boolean @default(true) @map("is_active")

  fields      FormField[]
  submissions FormSubmission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("forms")
}

enum FormFieldType {
  TEXT
  NUMBER
  EMAIL
  PHONE
  DATE
  TIME
  SELECT
  RADIO
  CHECKBOX
  TEXTAREA
  UPLOAD
}

model FormField {
  id     Int  @id @default(autoincrement())
  formId Int  @map("form_id")
  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  type        FormFieldType
  name        String        @db.VarChar(80)
  label       String        @db.VarChar(150)
  placeholder String?       @db.VarChar(150)
  helpText    String?       @map("help_text") @db.VarChar(255)
  required    Boolean       @default(false)
  options     Json // [{label, value}] for SELECT/RADIO/CHECKBOX
  validation  Json // {min,max,minLength,maxLength,pattern,accept,maxSizeMb}
  sortOrder   Int           @default(0) @map("sort_order")
  width       Int           @default(12)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([formId, sortOrder])
  @@map("form_fields")
}

model FormSubmission {
  id     Int  @id @default(autoincrement())
  formId Int  @map("form_id")
  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  data      Json
  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([formId])
  @@map("form_submissions")
}

// ─────────────────────────── Donations ───────────────────────────

model DonationProject {
  id               Int     @id @default(autoincrement())
  name             String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(200)
  description      String  @db.Text
  shortDescription String? @map("short_description") @db.VarChar(500)
  coverImage       String? @map("cover_image") @db.VarChar(500)
  bannerImage      String? @map("banner_image") @db.VarChar(500)

  targetAmount  Decimal @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(14, 2)
  currency      String  @default("THB") @db.VarChar(8)
  themeColor    String? @map("theme_color") @db.VarChar(20)

  /// Money required for 1 game token. Decimal, never float — token maths must be exact.
  /// Null disables token granting for this project.
  tokenValue   Decimal? @map("token_value") @db.Decimal(14, 2)
  /// Optional lifetime for tokens granted by this project; null = never expires.
  tokenTtlDays Int?     @map("token_ttl_days")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")

  /// Whether the public site may show how much this project has raised.
  /// When false the API omits the figures entirely rather than relying on the
  /// front-end to hide them, so they cannot be read out of the network response.
  showAmounts Boolean @default(true) @map("show_amounts")

  // SEO
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.VarChar(500)
  ogImage         String? @map("og_image") @db.VarChar(500)

  donations    Donation[]
  bankAccounts DonationProjectBankAccount[]
  games        GameDonationProject[]
  tokenGrants  TokenGrant[]
  ledger       TokenLedgerEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive, sortOrder])
  @@map("donation_projects")
}

model BankAccount {
  id            Int     @id @default(autoincrement())
  bankName      String  @map("bank_name") @db.VarChar(120)
  accountName   String  @map("account_name") @db.VarChar(150)
  accountNumber String  @map("account_number") @db.VarChar(40)
  branch        String? @db.VarChar(120)
  qrCodeUrl     String? @map("qr_code_url") @db.VarChar(500)
  isActive      Boolean @default(true) @map("is_active")

  projects DonationProjectBankAccount[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("bank_accounts")
}

model DonationProjectBankAccount {
  projectId     Int @map("project_id")
  bankAccountId Int @map("bank_account_id")

  project     DonationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bankAccount BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@id([projectId, bankAccountId])
  @@map("donation_project_bank_accounts")
}

enum DonationStatus {
  PENDING
  AUTO_VERIFIED
  VERIFIED
  NEEDS_REVIEW
  REJECTED
  CANCELLED
}

model Donation {
  id           Int    @id @default(autoincrement())
  donationCode String @unique @map("donation_code") @db.VarChar(20)

  projectId Int             @map("project_id")
  project   DonationProject @relation(fields: [projectId], references: [id])

  // Required on the public form, but nullable here: donations submitted before
  // these fields existed have no value and must not be invented.
  nickname     String?  @db.VarChar(150)
  accountName  String   @map("account_name") @db.VarChar(150)
  // Free-text name / address / phone for sending the donor their thank-you item.
  contactInfo  String?  @map("contact_info") @db.VarChar(500)
  amount       Decimal  @db.Decimal(14, 2)
  transferDate DateTime @map("transfer_date") @db.Date
  transferTime String   @map("transfer_time") @db.VarChar(8)
  slipUrl      String   @map("slip_url") @db.VarChar(500)
  remark       String?  @db.VarChar(500)

  status       DonationStatus @default(PENDING)
  verifiedById Int?           @map("verified_by_id")
  verifiedBy   User?          @relation("DonationVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?      @map("verified_at")
  rejectReason String?        @map("reject_reason") @db.VarChar(500)

  /// Resolved from accountName at submit time so token grants attach to one identity
  /// even when donors retype their name with different spacing or casing.
  accountIdentityId Int?             @map("account_identity_id")
  accountIdentity   AccountIdentity? @relation(fields: [accountIdentityId], references: [id])

  verification DonationVerification?
  logs         DonationLog[]
  /// At most one grant per donation — the DB-level guard against double-granting
  /// when an admin approves the same submission twice.
  tokenGrant   TokenGrant?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([projectId, status])
  @@index([status])
  @@map("donations")
}

model DonationVerification {
  id         Int      @id @default(autoincrement())
  donationId Int      @unique @map("donation_id")
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  provider   String  @db.VarChar(40)
  isSlip     Boolean @default(false) @map("is_slip")
  confidence Float   @default(0)

  extractedBankName      String?  @map("extracted_bank_name") @db.VarChar(120)
  extractedAccountNumber String?  @map("extracted_account_number") @db.VarChar(60)
  extractedAmount        Decimal? @map("extracted_amount") @db.Decimal(14, 2)
  extractedDate          String?  @map("extracted_date") @db.VarChar(20)
  extractedTime          String?  @map("extracted_time") @db.VarChar(20)
  referenceNumber        String?  @map("reference_number") @db.VarChar(80)
  qrPayload              String?  @map("qr_payload") @db.Text

  rawResult     Json    @map("raw_result")
  amountMatched Boolean @default(false) @map("amount_matched")
  dateMatched   Boolean @default(false) @map("date_matched")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("donation_verifications")
}

model DonationLog {
  id         Int      @id @default(autoincrement())
  donationId Int      @map("donation_id")
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  action     String  @db.VarChar(60)
  fromStatus String? @map("from_status") @db.VarChar(30)
  toStatus   String? @map("to_status") @db.VarChar(30)
  actorId    Int?    @map("actor_id")
  actor      User?   @relation(fields: [actorId], references: [id])
  note       String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([donationId])
  @@map("donation_logs")
}

// ─────────────────────────── Tokens ───────────────────────────

/// A player identity keyed only by their donation account name — deliberately not a
/// login. `normalizedName` is the comparison key (trimmed, whitespace-collapsed,
/// case-folded); `displayName` keeps the most recent raw spelling for display.
model AccountIdentity {
  id             Int    @id @default(autoincrement())
  normalizedName String @unique @map("normalized_name") @db.VarChar(190)
  displayName    String @map("display_name") @db.VarChar(190)

  /// Reserved for the optional claim-code / PIN hardening described in the brief.
  /// Null today: identity is account-name-only until an admin enables verification.
  claimSecretHash String?   @map("claim_secret_hash") @db.VarChar(255)
  verifiedAt      DateTime? @map("verified_at")

  donations    Donation[]
  tokenGrants  TokenGrant[]
  ledger       TokenLedgerEntry[]
  reservations Reservation[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("account_identities")
}

/// Tokens minted from one approved donation. `tokensRemaining` is the mutable
/// balance spent down under row lock; the ledger is the immutable audit trail and
/// the two must always reconcile.
model TokenGrant {
  id                Int             @id @default(autoincrement())
  accountIdentityId Int             @map("account_identity_id")
  accountIdentity   AccountIdentity @relation(fields: [accountIdentityId], references: [id])
  projectId         Int             @map("project_id")
  project           DonationProject @relation(fields: [projectId], references: [id])

  /// One grant per donation, enforced by the database: approving twice cannot mint twice.
  donationId Int      @unique @map("donation_id")
  donation   Donation @relation(fields: [donationId], references: [id])

  tokensGranted     Int       @map("tokens_granted")
  tokensRemaining   Int       @map("tokens_remaining")
  /// Snapshot of the project's tokenValue when minted, so later repricing cannot
  /// retroactively change what a donor already earned.
  tokenValueAtGrant Decimal   @map("token_value_at_grant") @db.Decimal(14, 2)
  donationAmount    Decimal   @map("donation_amount") @db.Decimal(14, 2)
  /// Remainder that did NOT become a token. Kept for auditability only — it is
  /// never carried into another submission's calculation.
  remainderAmount   Decimal   @map("remainder_amount") @db.Decimal(14, 2)
  expiresAt         DateTime? @map("expires_at")

  ledger TokenLedgerEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Spend ordering: soonest-expiring first, then FIFO.
  @@index([accountIdentityId, projectId, expiresAt, createdAt])
  @@map("token_grants")
}

enum TokenLedgerReason {
  GRANT
  SPEND
  REFUND
  REVOKE
  ADJUST
}

/// Append-only history. Every token movement writes one row; balances are never
/// mutated without a matching entry.
model TokenLedgerEntry {
  id                Int             @id @default(autoincrement())
  accountIdentityId Int             @map("account_identity_id")
  accountIdentity   AccountIdentity @relation(fields: [accountIdentityId], references: [id])
  projectId         Int             @map("project_id")
  project           DonationProject @relation(fields: [projectId], references: [id])

  grantId Int?        @map("grant_id")
  grant   TokenGrant? @relation(fields: [grantId], references: [id])

  reservationId Int?         @map("reservation_id")
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  /// Signed: positive mints, negative spends.
  delta       Int               @map("delta")
  reason      TokenLedgerReason
  description String?           @db.VarChar(255)
  actorId     Int?              @map("actor_id")
  actor       User?             @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountIdentityId, createdAt])
  @@index([grantId])
  @@map("token_ledger_entries")
}

// ─────────────────────────── Board game ───────────────────────────

enum GameStatus {
  DRAFT
  OPEN
  FULL
  REVEALED
  ARCHIVED
}

model Game {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(200)
  description String? @db.Text
  coverImage  String? @map("cover_image") @db.VarChar(500)

  tileCount      Int     @map("tile_count")
  /// Default face-down artwork; a tile may override it with its own image.
  tileFrontImage String? @map("tile_front_image") @db.VarChar(500)
  tokensPerTile  Int     @default(1) @map("tokens_per_tile")

  status   GameStatus @default(DRAFT)
  opensAt  DateTime?  @map("opens_at")
  closesAt DateTime?  @map("closes_at")

  /// Show reserver names on unrevealed tiles, or just "มีผู้จองแล้ว".
  showReserverNames  Boolean @default(true) @map("show_reserver_names")
  /// Null = unlimited tiles per account.
  maxTilesPerAccount Int?    @map("max_tiles_per_account")
  themeColor         String? @map("theme_color") @db.VarChar(20)

  /// Set when rewards are shuffled onto tiles. The hash commits to the assignment
  /// so it can be proven unchanged after the fact without revealing it early.
  shuffledAt     DateTime? @map("shuffled_at")
  commitmentHash String?   @map("commitment_hash") @db.VarChar(64)
  revealedAt     DateTime? @map("revealed_at")

  projects     GameDonationProject[]
  tiles        BoardTile[]
  rewards      Reward[]
  reservations Reservation[]
  revealEvents RevealEvent[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@map("games")
}

/// Which projects' tokens may be spent on which game.
model GameDonationProject {
  gameId    Int @map("game_id")
  projectId Int @map("project_id")

  game    Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  project DonationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([gameId, projectId])
  @@map("game_donation_projects")
}

/// A prize line. Count must equal the game's tile count before it can open.
model Reward {
  id        Int     @id @default(autoincrement())
  gameId    Int     @map("game_id")
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  label     String  @db.VarChar(500)
  imageUrl  String? @map("image_url") @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")
  /// Marks a line as an actual prize rather than a consolation message. Only these
  /// appear in the public winners list after the reveal.
  isPrize   Boolean @default(false) @map("is_prize")

  tile BoardTile?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([gameId, sortOrder])
  @@map("rewards")
}

model BoardTile {
  id          Int  @id @default(autoincrement())
  gameId      Int  @map("game_id")
  game        Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  boardNumber Int  @map("board_number")

  frontImage String? @map("front_image") @db.VarChar(500)

  /// Assigned by the server-side shuffle. Never serialized to any client before reveal.
  /// Globally unique: a reward can occupy exactly one tile, making the
  /// reward→tile assignment a bijection at the database level.
  rewardId Int?    @unique @map("reward_id")
  reward   Reward? @relation(fields: [rewardId], references: [id])

  reservation Reservation?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// The tile identity players address, and the guard against duplicate tiles.
  @@unique([gameId, boardNumber])
  @@map("board_tiles")
}

model Reservation {
  id     Int  @id @default(autoincrement())
  gameId Int  @map("game_id")
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// One reservation per tile, forever. This unique constraint — not application
  /// logic — is what makes concurrent claims on the same tile safe.
  tileId Int       @unique @map("tile_id")
  tile   BoardTile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  accountIdentityId   Int             @map("account_identity_id")
  accountIdentity     AccountIdentity @relation(fields: [accountIdentityId], references: [id])
  /// Frozen copy of the name as typed at reservation time, so historic results are
  /// not rewritten when an identity's display name changes later.
  accountNameSnapshot String          @map("account_name_snapshot") @db.VarChar(190)

  tokensSpent    Int    @map("tokens_spent")
  /// Client-supplied key; a retried or double-clicked request returns the original
  /// reservation instead of taking another tile.
  idempotencyKey String @map("idempotency_key") @db.VarChar(64)

  ledger TokenLedgerEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([gameId, idempotencyKey])
  @@index([gameId, accountIdentityId])
  @@map("reservations")
}

/// Immutable record of who revealed a game and when.
model RevealEvent {
  id     Int  @id @default(autoincrement())
  gameId Int  @map("game_id")
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  revealedById   Int?    @map("revealed_by_id")
  revealedBy     User?   @relation(fields: [revealedById], references: [id])
  tileCount      Int     @map("tile_count")
  commitmentHash String? @map("commitment_hash") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([gameId])
  @@map("reveal_events")
}

// ─────────────────────────── Media / Settings / Audit ───────────────────────────

model Media {
  id           Int     @id @default(autoincrement())
  fileName     String  @map("file_name") @db.VarChar(255)
  originalName String  @map("original_name") @db.VarChar(255)
  mimeType     String  @map("mime_type") @db.VarChar(120)
  type         String  @db.VarChar(20) // IMAGE | VIDEO | PDF | DOCUMENT
  size         Int
  url          String  @db.VarChar(500)
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(500)
  folder       String  @default("/") @db.VarChar(255)
  width        Int?
  height       Int?
  alt          String? @db.VarChar(255)

  uploadedById Int?  @map("uploaded_by_id")
  uploadedBy   User? @relation(fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([folder])
  @@index([type])
  @@map("media")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(120)
  value Json
  group String @default("general") @db.VarChar(60)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([group])
  @@map("settings")
}

model AuditLog {
  id     Int   @id @default(autoincrement())
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])

  action     String  @db.VarChar(60) // create | update | delete | login | verify | ...
  resource   String  @db.VarChar(60) // pages | donations | ...
  resourceId String? @map("resource_id") @db.VarChar(40)
  detail     Json?
  ip         String? @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([resource, resourceId])
  @@index([userId])
  @@map("audit_logs")
}

// Simple aggregate counter for dashboard "Total Visitors".
model VisitorStat {
  id    Int      @id @default(autoincrement())
  date  DateTime @unique @db.Date
  count Int      @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("visitor_stats")
}

// ── Birthday wish wall ──────────────────────────────────────

enum BirthdayWishStatus {
  PENDING
  APPROVED
  REJECTED
}

model BirthdayEvent {
  id            Int     @id @default(autoincrement())
  title         String  @db.VarChar(200)
  slug          String  @unique @db.VarChar(200)
  celebrantName String? @map("celebrant_name") @db.VarChar(150)
  description   String? @db.Text
  coverImage    String? @map("cover_image") @db.VarChar(500)
  themeColor    String? @map("theme_color") @db.VarChar(20)

  /// Closes the form. Deliberately separate from hiding the event: after the party the
  /// wall stays readable while no new wishes can be sent.
  isOpen           Boolean @default(true) @map("is_open")
  /// Hides the whole event from the website, wall included.
  isActive         Boolean @default(true) @map("is_active")
  /// When true a wish waits for an admin before it floats; when false it appears at once.
  requiresApproval Boolean @default(false) @map("requires_approval")

  gifts       BirthdayGift[]
  backgrounds BirthdayCardBackground[]
  wishes      BirthdayWish[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("birthday_events")
}

/// Artwork behind the greeting card a wish becomes — the picture people save and send on.
/// Nothing to do with the balloon: the wall never shows it.
model BirthdayCardBackground {
  id      Int           @id @default(autoincrement())
  eventId Int           @map("event_id")
  event   BirthdayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name String @db.VarChar(200)
  /// Required, unlike a gift's: a background with no picture is not a choice.
  imageUrl  String  @map("image_url") @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  wishes BirthdayWish[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([eventId, sortOrder])
  @@map("birthday_card_backgrounds")
}

/// The catalogue an admin uploads; a visitor ties one of these under their balloon.
model BirthdayGift {
  id      Int           @id @default(autoincrement())
  eventId Int           @map("event_id")
  event   BirthdayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(200)
  imageUrl  String? @map("image_url") @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  wishes BirthdayWish[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([eventId, sortOrder])
  @@map("birthday_gifts")
}

model BirthdayWish {
  id      Int           @id @default(autoincrement())
  eventId Int           @map("event_id")
  event   BirthdayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name    String @db.VarChar(60)
  message String @db.Text

  balloonShape String @default("round") @map("balloon_shape") @db.VarChar(20)
  balloonColor String @default("#0ea5e9") @map("balloon_color") @db.VarChar(20)

  photoUrl  String? @map("photo_url") @db.VarChar(500)
  /// How the photo sits inside the balloon: a zoom plus an x/y offset in the shape's
  /// 100×100 box. Stored beside the original upload rather than baked into it, so the
  /// picture can be reframed later without a re-upload.
  photoZoom Float?  @map("photo_zoom")
  photoX    Float?  @map("photo_x")
  photoY    Float?  @map("photo_y")

  /// SetNull, not Cascade: retiring a gift from the catalogue must not delete the
  /// wishes that chose it.
  giftId Int?          @map("gift_id")
  gift   BirthdayGift? @relation(fields: [giftId], references: [id], onDelete: SetNull)

  /// The card artwork this wish was written on. Null is the plain card, and is also where
  /// a wish lands if its background is later deleted outright — same reasoning as the gift.
  backgroundId Int?                    @map("background_id")
  background   BirthdayCardBackground? @relation(fields: [backgroundId], references: [id], onDelete: SetNull)

  status BirthdayWishStatus @default(APPROVED)

  /// Moderation only — never leaves the admin API.
  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([eventId, status, createdAt])
  @@map("birthday_wishes")
}
