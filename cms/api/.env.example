# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEBSITE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
DATABASE_URL="mysql://cms:cms_password@localhost:3306/cms"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# S3 (any S3-compatible: AWS, MinIO, DigitalOcean Spaces, Cloudflare R2)
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=cms-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# OCR: tesseract | google-vision | aws-textract | azure-vision | none
OCR_PROVIDER=tesseract
OCR_AUTO_VERIFY_CONFIDENCE=0.8
GOOGLE_VISION_API_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CMS <no-reply@example.com>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
