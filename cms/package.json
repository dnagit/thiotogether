{
  "name": "cms-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Headless CMS + Dynamic Website Platform",
  "workspaces": [
    "shared",
    "api",
    "admin",
    "website"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin,website -c blue,green,magenta \"npm:dev:api\" \"npm:dev:admin\" \"npm:dev:website\"",
    "dev:api": "npm run dev -w api",
    "dev:admin": "npm run dev -w admin",
    "dev:website": "npm run dev -w website",
    "build": "npm run build -w shared && npm run build -w api && npm run build -w admin && npm run build -w website",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\"",
    "prisma:generate": "npm run prisma:generate -w api",
    "prisma:migrate": "npm run prisma:migrate -w api",
    "prisma:seed": "npm run prisma:seed -w api",
    "test": "npm run test -w api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.26.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
